{
  "name": "agent-tool-calls",
  "version": "0.0.0",
  "private": true,
  "description": "Generic, reusable tool implementations — zero AI/agent-framework dependencies",
  "license": "MIT",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.9.18",
    "typescript": "^6.0.0",
    "vitest": "^3.2.6"
  }
}
